# Supabase: Project Settings > API (leave all four empty for demo mode)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY        # server only, never expose
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# On Vercel, EXTRACTOR_URL and REVIEW_URL are injected by the service bindings in vercel.json: leave them unset there.
# Locally the defaults are used (extractor :8001; review service reached through the Next.js dev rewrite).
EXTRACTOR_URL=
REVIEW_URL=
EXTRACTOR_KEY=                                         # optional shared secret, set the same value on the extractor

# Optional extra protection for the Python explain / guideline-import endpoints (not publicly routed on Vercel).
INTERNAL_KEY=

# Optional AI. Without these the app still works; explanations show matched rulebook lines only.
LLM_PROVIDER=                                          # anthropic or gemini (optional: the provider whose key is set is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash                          # use a current model name from Google AI Studio
EMBEDDINGS_URL=                                        # any OpenAI-compatible /embeddings endpoint
                                                       # Gemini: https://generativelanguage.googleapis.com/v1beta/openai/embeddings
EMBEDDINGS_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small                # Gemini: gemini-embedding-001
